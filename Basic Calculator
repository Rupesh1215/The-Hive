import java.io.*;
import java.util.*;

public class Main {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Main. */
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();

        int result = s.nextInt();

        for(int i = 0; i < n-1; i++){
            String operator = s.next();
            int next = s.nextInt();

            switch (operator){

                case "+":
                    result += next;
                    break;
                case "-":
                    result -= next;
                    break;
                case "/":
                    result /= next;
                    break;
                case "%":
                    result %= next;
                    if(result < 0){
                        result += next;
                    }
                    break;
                case "*":
                    result *= next;
                    break;
            }
        }

        System.out.print(result);
    }
}

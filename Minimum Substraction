import java.io.*;
import java.util.*;
import java.math.*;

public class Main {

    public static void main(String[] args) {
        /* Enter your code here. Read input from STDIN. Print output to STDOUT. Your class should be named Main. */
        Scanner s = new Scanner(System.in);
        int n = s.nextInt();

        int twoPower = 1;
        while(twoPower*2 <= n){
            twoPower *= 2;
        }

        System.out.println(n-twoPower);
    }
}
